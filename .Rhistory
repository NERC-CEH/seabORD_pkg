# run function:
example_DD_map <- seabORD::calc_birddensmap_dd_pinhalf(dmap, fr, pinhalf)
DD_map = example_DD_map
colony = example_colony_3035
crop = TRUE
km_to_left = 30
km_to_right = 50
km_up = 30
km_down = 70
title = "DD map"
caption = NULL
crop
is.null(colony)
crop_extent <- raster::extent(
sf::st_bbox(colony)$xmin - (km_to_left * 1000),
sf::st_bbox(colony)$xmin + (km_to_right * 1000),
sf::st_bbox(colony)$ymin - (km_down * 1000),
sf::st_bbox(colony)$ymin + (km_up * 1000)
)
DD_map <- raster::crop(
DD_map,
crop_extent
)
if (crop) {
if (is.null(colony)) {
stop("A colony location must be supplied when crop = TRUE.")
}
crop_extent <- raster::extent(
sf::st_bbox(colony)$xmin - (km_to_left * 1000),
sf::st_bbox(colony)$xmin + (km_to_right * 1000),
sf::st_bbox(colony)$ymin - (km_down * 1000),
sf::st_bbox(colony)$ymin + (km_up * 1000)
)
DD_map <- raster::crop(
DD_map,
crop_extent
)
}
